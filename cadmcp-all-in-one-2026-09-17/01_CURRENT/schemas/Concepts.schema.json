      "required": [
        "id",
        "component_a",
        "component_b",
        "kind",
        "description",
        "allowed_motion"
      ],
      "title": "Interface",
      "type": "object"
    },
    "Mechanism": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "pattern_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Pattern Id",
          "type": "string"
        },
        "function_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Function Ids",
          "type": "array"
        },
        "component_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "input_direction": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Direction"
        },
        "output_direction": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Direction"
        },
        "return_method": {
          "enum": [
            "switch_internal",
            "printed_flexure",
            "metal_spring",
            "none",
            "not_applicable"
          ],
          "title": "Return Method",
          "type": "string"
        },
        "hard_stop": {
          "title": "Hard Stop",
          "type": "boolean"
        },
        "force_path": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Force Path",
          "type": "string"
        },
        "failure_modes": {
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Modes",
          "type": "array"
        },
        "verification_notes": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Verification Notes",
          "type": "string"
        },
        "reference_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        },
        "motion_relation": {
          "anyOf": [
            {
              "enum": [
                "direct",
                "lever",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion Relation"
        }
      },
      "required": [
        "id",
        "pattern_id",
        "function_ids",
        "component_ids",
        "return_method",
        "hard_stop",
        "force_path",
        "failure_modes",
        "verification_notes"
