        "component_a": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Component A",
          "type": "string"
        },
        "component_b": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Component B",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mount",
            "load",
            "contact",
            "guide",
            "return",
            "stop"
