          "type": "string"
        },
        "quote": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "blocks": {
          "enum": [
            "intent",
            "concepts",
            "plan",
            "release"
          ],
          "title": "Blocks",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "blocks"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Concept"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "Concepts",
  "type": "object"
}
