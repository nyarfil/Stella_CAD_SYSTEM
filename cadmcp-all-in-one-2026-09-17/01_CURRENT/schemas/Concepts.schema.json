          "title": "Kind",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "allowed_motion": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Allowed Motion",
          "type": "string"
        }
