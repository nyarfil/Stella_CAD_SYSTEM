{
  "$defs": {
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "sensor",
            "switch",
            "usb",
            "wheel",
            "cable",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "specified",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 8,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "evidence"
      ],
      "title": "Opening",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 104857600,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "bytes"
      ],
      "title": "SourceFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3.3",
      "default": "0.3.3",
      "title": "Schema Version",
      "type": "string"
    },
    "shell_pack_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Shell Pack Id",
      "type": "string"
    },
    "unit": {
      "const": "mm",
      "title": "Unit",
      "type": "string"
    },
    "source_step": {
      "$ref": "#/$defs/SourceFile"
    },
    "wall_thickness_mm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Thickness Mm"
    },
    "thickness_status": {
      "enum": [
        "measured",
        "specified",
        "unverified"
      ],
      "title": "Thickness Status",
      "type": "string"
    },
    "openings": {
      "items": {
        "$ref": "#/$defs/Opening"
      },
      "maxItems": 64,
      "title": "Openings",
      "type": "array"
    },
    "protected_outer": {
      "title": "Protected Outer",
      "type": "boolean"
    },
    "unresolved_required_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Unresolved Required Fields",
      "type": "array"
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "shell_pack_id",
    "unit",
    "source_step",
    "thickness_status",
    "protected_outer",
    "status"
  ],
  "title": "ShellPack",
  "type": "object"
}
