{
  "$defs": {
    "EvidenceInspection": {
      "additionalProperties": false,
      "properties": {
        "attachment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attachment Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "json",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "attachment_path": {
          "default": "",
          "maxLength": 4096,
          "title": "Attachment Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "viewed",
            "unreadable"
          ],
          "title": "Status",
          "type": "string"
        },
        "observation": {
          "maxLength": 2000,
          "minLength": 8,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "attachment_sha256",
        "kind",
        "status",
        "observation"
      ],
      "title": "EvidenceInspection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Id",
      "type": "string"
    },
    "finding_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Finding Id",
      "type": "string"
    },
    "responder_label": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Responder Label",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "accept_and_revise",
        "request_evidence",
        "disagree_with_evidence"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "explanation": {
      "maxLength": 4000,
      "minLength": 12,
      "title": "Explanation",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "correction_of_reviewer_error": {
      "default": false,
      "title": "Correction Of Reviewer Error",
      "type": "boolean"
    },
    "evidence_inspections": {
      "items": {
        "$ref": "#/$defs/EvidenceInspection"
      },
      "maxItems": 32,
      "title": "Evidence Inspections",
      "type": "array"
    }
  },
  "required": [
    "review_id",
    "finding_id",
    "responder_label",
    "disposition",
    "explanation",
    "evidence"
  ],
  "title": "Reply",
  "type": "object"
}
