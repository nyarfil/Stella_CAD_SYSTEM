        "points_mm": {
          "items": {
            "items": {
              "maximum": 1000000,
              "minimum": -1000000,
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Points Mm",
          "type": "array"
        },
        "z_min_mm": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Z Min Mm",
          "type": "number"
        },
        "z_max_mm": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Z Max Mm",
          "type": "number"
        },
        "max_symmetric_difference_mm3": {
          "maximum": 1000000000000.0,
          "minimum": 0,
