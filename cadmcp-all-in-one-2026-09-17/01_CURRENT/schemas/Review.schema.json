{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "claim": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "proposed_change": {
          "maxLength": 4000,
          "minLength": 8,
          "title": "Proposed Change",
          "type": "string"
        },
        "required_test": {
          "maxLength": 4000,
          "minLength": 8,
          "title": "Required Test",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "claim",
        "evidence",
        "proposed_change",
        "required_test"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "subject_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    },
    "role": {
      "enum": [
        "requirements",
        "mechanism",
        "assembly",
        "manufacturing",
        "verification"
      ],
      "title": "Role",
      "type": "string"
    },
    "discussion_round": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Discussion Round",
      "type": "integer"
    },
    "reviewer_label": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Reviewer Label",
      "type": "string"
    },
    "execution_description": {
      "maxLength": 400,
      "minLength": 8,
      "title": "Execution Description",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 64,
      "title": "Findings",
      "type": "array"
    },
    "remaining_uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Remaining Uncertainties",
      "type": "array"
    },
    "conclusion": {
      "enum": [
        "revise",
        "no_blocker_found"
      ],
      "title": "Conclusion",
      "type": "string"
    }
  },
  "required": [
    "subject_digest",
    "role",
    "reviewer_label",
    "execution_description",
    "remaining_uncertainties",
    "conclusion"
  ],
  "title": "Review",
  "type": "object"
}
