# Secrets — none are needed by design (the Claude CLI carries its own auth),
# but never let one slip in.
.env
.env.*
*.pem
*.key

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/node_modules/

# Logs & session artifacts — keep the skeleton dir only.
logs/*
!logs/.gitkeep
*.log

# Run output — generated by agent design runs; keep the skeleton only.
projects/*
!projects/.gitkeep

# Editor / OS
.vscode/
.DS_Store
*.DS_Store

# Agent scratch state
.remember/
